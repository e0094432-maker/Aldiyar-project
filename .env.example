# Публичный адрес сайта (для canonical, hreflang, sitemap)
NEXT_PUBLIC_SITE_URL=https://eduforge.kz

# SMTP для отправки заявок. Если SMTP_HOST пустой — заявки пишутся в лог сервера.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# От кого письма и куда приходят заявки (можно несколько через запятую)
MAIL_FROM="EduForge Advisory <no-reply@eduforge.kz>"
LEADS_TO=info@eduforge.kz
